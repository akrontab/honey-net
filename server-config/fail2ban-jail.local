# Fail2ban jail protecting the real SSH port (65022).
# Installed to /etc/fail2ban/jail.d/honeypot-host.local by setup.sh.
# Does NOT touch honeypot ports — we want attackers to reach them freely.

[sshd]
enabled  = true
port     = 65022
filter   = sshd
logpath  = /var/log/auth.log
maxretry = 4
findtime = 300
bantime  = 3600
