[
  {
    "name": "log-stack",
    "type": "backend",
    "ssh_key": "~/.ssh/log-stack-linode",
    "tailscale_ephemeral": false,
    "honeypots": []
  },
  {
    "name": "malware-catalog",
    "type": "backend",
    "ssh_key": "~/.ssh/malware-catalog-linode",
    "tailscale_ephemeral": false,
    "honeypots": []
  },
  {
    "name": "mysql-ssh",
    "type": "honeypot",
    "ssh_key": "~/.ssh/mysql-ssh-honeypot",
    "tailscale_ephemeral": true,
    "honeypots": [
      "cowrie",
      "http",
      "mysql"
    ],
    "addons": [
      "metadata",
      "malware-sender"
    ]
  },
  {
    "name": "smb-ftp",
    "type": "honeypot",
    "ssh_key": "~/.ssh/smb-ftp-linode",
    "tailscale_ephemeral": true,
    "honeypots": [
      "ftp",
      "smb"
    ],
    "addons": [
      "metadata",
      "malware-sender"
    ]
  }
]
