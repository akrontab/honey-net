{
  "title": "Triage / Detections",
  "uid": "triage-detections",
  "description": "Phase 1 detection dashboard — what fired in the last X, by severity / category / entity. Consumes {job=\"detections\"} emitted by the alerting detector. Folds into the Triage tier alert-state slot.",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "tags": ["triage", "detections", "alerting"],
  "links": [],
  "annotations": {"list": []},
  "templating": {
    "list": [
      {
        "name": "severity",
        "label": "Severity",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values({job=\"detections\"}, severity)",
        "definition": "label_values({job=\"detections\"}, severity)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {"selected": false, "text": "All", "value": "$__all"}
      },
      {
        "name": "category",
        "label": "Category",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values({job=\"detections\", severity=~\"$severity\"}, category)",
        "definition": "label_values({job=\"detections\", severity=~\"$severity\"}, category)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {"selected": false, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Detections",
      "description": "All detections in the selected time range",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "orange"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"detections\", severity=~\"$severity\", category=~\"$category\"} [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Page",
      "description": "Detections with severity=page (requires immediate attention)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "red"},
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"detections\", severity=\"page\"} [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Notice",
      "description": "Detections with severity=notice (high-signal, batchable)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "yellow"},
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"detections\", severity=\"notice\"} [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unique Rules Fired",
      "description": "Distinct rule_id values seen in the selected range",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "count(count by (rule_id) (count_over_time({job=\"detections\", severity=~\"$severity\", category=~\"$category\"} [$__range])))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Detection Rate by Severity",
      "description": "Detection events per minute, split by severity",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "page"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "notice"},
            "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]
          }
        ]
      },
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum by (severity) (count_over_time({job=\"detections\", severity=~\"$severity\", category=~\"$category\"} [$__interval]))",
        "legendFormat": "{{severity}}",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Recent Detections",
      "description": "Latest detection events from {job=\"detections\"} — parsed JSON fields visible in details",
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "{job=\"detections\", severity=~\"$severity\", category=~\"$category\"} | json",
        "maxLines": 200,
        "refId": "A"
      }]
    }
  ]
}
