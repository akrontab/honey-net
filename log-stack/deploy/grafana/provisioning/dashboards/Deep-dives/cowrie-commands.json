{
  "title": "Cowrie — Commands & Sessions",
  "uid": "cowrie-commands",
  "description": "Session activity, commands executed by attackers, and file download events",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "tags": ["honeypot", "cowrie"],
  "links": [],
  "annotations": {"list": []},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Commands Entered",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.command.input\" [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "IPs That Ran Commands",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "orange"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "count(sum by (src_ip) (count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.command.input\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "File Downloads",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "red"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.file_download\" [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Activity Rate / sec",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"}
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Downloads"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Commands"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]
          }
        ]
      },
      "options": {
        "legend": {"calcs": ["max"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.command.input\" [$__interval]))",
          "legendFormat": "Commands",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.file_download\" [$__interval]))",
          "legendFormat": "Downloads",
          "queryType": "range",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top Commands",
      "gridPos": {"h": 14, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "left", "displayMode": "auto", "filterable": false}
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {"show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Count"}]
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "topk(20, sum by (input) (count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.command.input\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "legendFormat": "{{input}}",
        "refId": "A"
      }],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"input": "Command", "Value #A": "Count"}}}
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Command Stream (live)",
      "gridPos": {"h": 14, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "{job=\"cowrie\"} | json | eventid=\"cowrie.command.input\"",
        "queryType": "range",
        "refId": "A"
      }]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "File Download Events",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 26},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "{job=\"cowrie\"} | json | eventid=\"cowrie.session.file_download\"",
        "queryType": "range",
        "refId": "A"
      }]
    }
  ]
}
