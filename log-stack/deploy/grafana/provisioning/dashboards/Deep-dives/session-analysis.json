{
  "title": "Session Analysis",
  "uid": "session-analysis",
  "description": "Session quality (drive-by vs interactive) and TCP tunnel/proxy abuse via direct-tcpip",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "tags": ["honeypot", "cowrie"],
  "links": [],
  "annotations": {"list": []},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Drive-by Sessions (< 1s)",
      "description": "Automated scanners that connect and immediately disconnect — pure noise",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.closed\" | duration < 1 [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Short Sessions (1–60s)",
      "description": "Brief scripted sessions — credential spray bots that log in and quickly exit",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "orange"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.closed\" | duration >= 1 | duration <= 60 [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Interactive Sessions (> 60s)",
      "description": "Longer sessions — attacker is likely running multiple commands or exploring",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "red"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.closed\" | duration > 60 [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "TCP Tunnel Requests",
      "description": "direct-tcpip port forward requests — attacker using honeypot as a proxy",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "purple"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.direct-tcpip.request\" [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Session Quality Over Time",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"}
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Drive-by (< 1s)"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Short (1–60s)"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Interactive (> 60s)"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          }
        ]
      },
      "options": {
        "legend": {"calcs": ["max"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.closed\" | duration < 1 [$__interval]))",
          "legendFormat": "Drive-by (< 1s)",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.closed\" | duration >= 1 | duration <= 60 [$__interval]))",
          "legendFormat": "Short (1–60s)",
          "queryType": "range",
          "refId": "B"
        },
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.closed\" | duration > 60 [$__interval]))",
          "legendFormat": "Interactive (> 60s)",
          "queryType": "range",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top Tunnel Destination IPs",
      "description": "IPs that attackers are trying to reach through the honeypot as a proxy",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {"custom": {"align": "left", "displayMode": "auto", "filterable": true}},
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {"show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Count"}]
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "topk(15, sum by (dst_ip) (count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.direct-tcpip.request\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "legendFormat": "{{dst_ip}}",
        "refId": "A"
      }],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"dst_ip": "Destination IP", "Value #A": "Count"}}}
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top Tunnel Destination Ports",
      "description": "Ports targeted via proxy — 25/465/587 = SMTP spam relay, 3306 = MySQL pivot, 6379 = Redis",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {"custom": {"align": "left", "displayMode": "auto", "filterable": true}},
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {"show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Count"}]
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "topk(15, sum by (dst_port) (count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.direct-tcpip.request\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "legendFormat": "{{dst_port}}",
        "refId": "A"
      }],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"dst_port": "Destination Port", "Value #A": "Count"}}}
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "TCP Tunnel Events (live)",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 22},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "{job=\"cowrie\"} | json | eventid=~\"cowrie.direct-tcpip.*\"",
        "queryType": "range",
        "refId": "A"
      }]
    }
  ]
}
