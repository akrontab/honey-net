{
  "title": "Hunt / Credential Intel",
  "uid": "hunt-credential-intel",
  "description": "Cross-protocol login analysis on the {job=\"events\"} normalized contract. Reveals credential spray patterns, password wordlists, and success rates across every honeypot surface without coupling to any specific honeypot.",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-7d", "to": "now"},
  "timepicker": {},
  "refresh": "5m",
  "timezone": "browser",
  "graphTooltip": 1,
  "tags": ["hunt", "events", "credentials", "login"],
  "links": [],
  "annotations": {"list": []},
  "templating": {
    "list": [
      {
        "name": "honeypot",
        "label": "Honeypot",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values({job=\"events\"}, honeypot)",
        "definition": "label_values({job=\"events\"}, honeypot)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {"selected": false, "text": "All", "value": "$__all"}
      },
      {
        "name": "host",
        "label": "Sensor host",
        "type": "query",
        "datasource": {"type": "loki", "uid": "loki"},
        "query": "label_values({job=\"events\", honeypot=~\"$honeypot\"}, host)",
        "definition": "label_values({job=\"events\", honeypot=~\"$honeypot\"}, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {"selected": false, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Login Attempts",
      "description": "Total authentication attempts across all protocols in range",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "orange"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"events\", honeypot=~\"$honeypot\", host=~\"$host\"} | json | event_type=\"login\" [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unique Attackers",
      "description": "Distinct source IPs that attempted at least one login",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "red"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "count(sum by (src_ip) (count_over_time({job=\"events\", honeypot=~\"$honeypot\", host=~\"$host\"} | json | event_type=\"login\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unique Usernames",
      "description": "Distinct usernames in the spray wordlist",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "count(sum by (username) (count_over_time({job=\"events\", honeypot=~\"$honeypot\", host=~\"$host\"} | json | event_type=\"login\" | username != \"\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unique Passwords",
      "description": "Distinct passwords in the spray wordlist",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "purple"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "count(sum by (password) (count_over_time({job=\"events\", honeypot=~\"$honeypot\", host=~\"$host\"} | json | event_type=\"login\" | password != \"\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Successful Logins",
      "description": "Credentials that were accepted by the honeypot (meta_login_success=true). Every login is accepted by design — this counts the volume of \"successful\" sessions.",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "dark-orange"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "dark-orange", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"events\", honeypot=~\"$honeypot\", host=~\"$host\"} | json | event_type=\"login\" | meta_login_success=\"true\" [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Login Rate over Time — Failed vs Successful",
      "description": "Two series: all failed logins (red) and successful logins (green). A green spike means a credential was accepted; correlate with the Attacker Profile dashboard to trace what that session did next.",
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 4},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"}
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Failed"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Successful"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]
          }
        ]
      },
      "options": {
        "legend": {"calcs": ["max", "sum"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"events\", honeypot=~\"$honeypot\", host=~\"$host\"} | json | event_type=\"login\" | meta_login_success!=\"true\" [$__interval]))",
          "legendFormat": "Failed",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"events\", honeypot=~\"$honeypot\", host=~\"$host\"} | json | event_type=\"login\" | meta_login_success=\"true\" [$__interval]))",
          "legendFormat": "Successful",
          "queryType": "range",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Logins by Honeypot",
      "description": "Which surfaces are being sprayed hardest",
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 4},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum by (honeypot) (count_over_time({job=\"events\", honeypot=~\"$honeypot\", host=~\"$host\"} | json | event_type=\"login\" [$__range]))",
        "instant": true,
        "queryType": "instant",
        "legendFormat": "{{honeypot}}",
        "refId": "A"
      }]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top Username / Password Combos",
      "description": "Most-tried credential pairs. Pairs appearing across multiple honeypots indicate a shared spray tool.",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {"custom": {"align": "left", "displayMode": "auto", "filterable": true}},
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {"show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Count"}]
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "topk(50, sum by (username, password) (count_over_time({job=\"events\", honeypot=~\"$honeypot\", host=~\"$host\"} | json | event_type=\"login\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "legendFormat": "{{username}} / {{password}}",
        "refId": "A"
      }],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"username": "Username", "password": "Password", "Value #A": "Count"}}}
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top Usernames",
      "description": "Most targeted usernames across all protocols",
      "gridPos": {"h": 10, "w": 6, "x": 12, "y": 13},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {"custom": {"align": "left", "displayMode": "auto", "filterable": true}},
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {"show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Count"}]
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "topk(25, sum by (username) (count_over_time({job=\"events\", honeypot=~\"$honeypot\", host=~\"$host\"} | json | event_type=\"login\" | username != \"\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "legendFormat": "{{username}}",
        "refId": "A"
      }],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"username": "Username", "Value #A": "Count"}}}
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top Passwords",
      "description": "Most used passwords — reveals spray wordlist content",
      "gridPos": {"h": 10, "w": 6, "x": 18, "y": 13},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {"custom": {"align": "left", "displayMode": "auto", "filterable": true}},
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {"show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Count"}]
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "topk(25, sum by (password) (count_over_time({job=\"events\", honeypot=~\"$honeypot\", host=~\"$host\"} | json | event_type=\"login\" | password != \"\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "legendFormat": "{{password}}",
        "refId": "A"
      }],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"password": "Password", "Value #A": "Count"}}}
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Recent Successful Logins",
      "description": "Login events where the honeypot accepted the credential — these sessions may proceed to run commands or download payloads",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 23},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "{job=\"events\", honeypot=~\"$honeypot\", host=~\"$host\"} | json | event_type=\"login\" | meta_login_success=\"true\"",
        "queryType": "range",
        "refId": "A"
      }]
    }
  ]
}
