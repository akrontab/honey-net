{
  "title": "MySQL — Honeypot Overview",
  "uid": "mysql-overview",
  "description": "MySQL wire-protocol honeypot: connections, credential attempts, and SQL queries",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "tags": ["honeypot", "mysql"],
  "links": [],
  "annotations": {"list": []},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Connections",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "blue"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"mysql\"} | json | event=\"connect\" [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unique Attacker IPs",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "purple"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "count(sum by (src_ip) (count_over_time({job=\"mysql\"} | json | event=\"connect\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "SQL Queries",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "red"},
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "sum(count_over_time({job=\"mysql\"} | json | event=\"query\" [$__range]))",
        "instant": true,
        "queryType": "instant",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connections & Logins over time",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {"group": "A", "mode": "none"}
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Connections"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Logins"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Queries"},
            "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
          }
        ]
      },
      "options": {
        "legend": {"calcs": ["max"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"mysql\"} | json | event=\"connect\" [$__interval]))",
          "legendFormat": "Connections",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"mysql\"} | json | event=\"login\" [$__interval]))",
          "legendFormat": "Logins",
          "queryType": "range",
          "refId": "B"
        },
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "sum(count_over_time({job=\"mysql\"} | json | event=\"query\" [$__interval]))",
          "legendFormat": "Queries",
          "queryType": "range",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top Source IPs",
      "gridPos": {"h": 10, "w": 8, "x": 0, "y": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "left", "displayMode": "auto", "filterable": false}
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {"show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Count"}]
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "topk(15, sum by (src_ip) (count_over_time({job=\"mysql\"} | json | event=\"connect\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "legendFormat": "{{src_ip}}",
        "refId": "A"
      }],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"src_ip": "Source IP", "Value #A": "Count"}}}
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Top Usernames",
      "gridPos": {"h": 10, "w": 8, "x": 8, "y": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "left", "displayMode": "auto", "filterable": false}
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {"show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Count"}]
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "topk(15, sum by (username) (count_over_time({job=\"mysql\"} | json | event=\"login\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "legendFormat": "{{username}}",
        "refId": "A"
      }],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"username": "Username", "Value #A": "Count"}}}
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top Databases Targeted",
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 12},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "left", "displayMode": "auto", "filterable": false}
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {"show": false},
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Count"}]
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "topk(15, sum by (database) (count_over_time({job=\"mysql\"} | json | event=\"login\" | database != \"\" [$__range])))",
        "instant": true,
        "queryType": "instant",
        "legendFormat": "{{database}}",
        "refId": "A"
      }],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"database": "Database", "Value #A": "Count"}}}
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Recent SQL Queries",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 22},
      "datasource": {"type": "loki", "uid": "loki"},
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "{job=\"mysql\"} | json | event=\"query\"",
        "queryType": "range",
        "refId": "A"
      }]
    }
  ]
}
