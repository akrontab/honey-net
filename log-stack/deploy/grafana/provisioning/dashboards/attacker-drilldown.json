      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "topk(5, sum by (version) (count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.client.version\" | src_ip=\"$src_ip\" [$__range])))",
