        "refId": "A"
      }],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true}, "renameByName": {"url": "URL", "Value #A": "Downloads"}}}
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "SSH Client Fingerprints",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 22},
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {
        "defaults": {"custom": {"align": "left", "displayMode": "auto", "filterable": false}},
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
